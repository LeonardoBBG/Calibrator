{
  "$defs": {
    "BarristerPersona": {
      "enum": [
        "SOL",
        "FABLE"
      ],
      "title": "BarristerPersona",
      "type": "string"
    },
    "EvidenceLink": {
      "additionalProperties": false,
      "description": "A substantive claim tied to the exact paragraphs said to support it.",
      "properties": {
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "paragraph_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paragraph Ids",
          "type": "array"
        },
        "relationship": {
          "default": "SUPPORTS",
          "enum": [
            "SUPPORTS",
            "CONTRADICTS",
            "CONTEXT"
          ],
          "title": "Relationship",
          "type": "string"
        }
      },
      "required": [
        "claim",
        "paragraph_ids"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "LLMUsage": {
      "additionalProperties": false,
      "description": "Provider provenance without persisting credentials or unstable price data.",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "observed_attempts": {
          "default": 1,
          "minimum": 1,
          "title": "Observed Attempts",
          "type": "integer"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "request_ids": {
          "items": {
            "type": "string"
          },
          "title": "Request Ids",
          "type": "array"
        },
        "requested_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Model"
        },
        "response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Id"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "LLMUsage",
      "type": "object"
    },
    "PartySide": {
      "enum": [
        "CLAIMANT",
        "RESPONDENT"
      ],
      "title": "PartySide",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "argument_id": {
      "title": "Argument Id",
      "type": "string"
    },
    "backend": {
      "title": "Backend",
      "type": "string"
    },
    "barrister": {
      "$ref": "#/$defs/BarristerPersona"
    },
    "challenges_for_opponent": {
      "items": {
        "type": "string"
      },
      "title": "Challenges For Opponent",
      "type": "array"
    },
    "concessions_or_risks": {
      "items": {
        "type": "string"
      },
      "title": "Concessions Or Risks",
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Gaps",
      "type": "array"
    },
    "evidence_links": {
      "items": {
        "$ref": "#/$defs/EvidenceLink"
      },
      "title": "Evidence Links",
      "type": "array"
    },
    "hidden_assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Hidden Assumptions",
      "type": "array"
    },
    "opponent_turn_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Opponent Turn Id"
    },
    "paragraph_citations": {
      "items": {
        "type": "string"
      },
      "title": "Paragraph Citations",
      "type": "array"
    },
    "position": {
      "title": "Position",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "protect_or_defend_points": {
      "items": {
        "type": "string"
      },
      "title": "Protect Or Defend Points",
      "type": "array"
    },
    "responses_to_opponent": {
      "items": {
        "type": "string"
      },
      "title": "Responses To Opponent",
      "type": "array"
    },
    "round_number": {
      "minimum": 1,
      "title": "Round Number",
      "type": "integer"
    },
    "side": {
      "$ref": "#/$defs/PartySide"
    },
    "supporting_points": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Points",
      "type": "array"
    },
    "turn_id": {
      "title": "Turn Id",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/LLMUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "turn_id",
    "argument_id",
    "round_number",
    "barrister",
    "side",
    "position",
    "supporting_points",
    "responses_to_opponent",
    "challenges_for_opponent",
    "concessions_or_risks",
    "hidden_assumptions",
    "evidence_gaps",
    "protect_or_defend_points",
    "paragraph_citations",
    "confidence",
    "backend",
    "prompt_version"
  ],
  "title": "DebateTurn",
  "type": "object"
}
